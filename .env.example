# Laravel API (Sanctum SPA auth). The admin and the API must share a parent domain so the session cookie is sent,
# e.g. localhost:3003 + localhost:8000 locally, or admin.everdigitech.com + api.everdigitech.com in production.
# The API must list this admin's origin in SANCTUM_STATEFUL_DOMAINS and CORS_ALLOWED_ORIGINS (see api/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: NEXT_PUBLIC_API_URL=https://api.everdigitech.com

# Which parts use mock data (lib/mock) instead of the Laravel API. Set it per area, because some endpoints aren't
# built yet. The value is baked in at build time, so restart `npm run dev` (or rebuild) after changing it.
#
#   NEXT_PUBLIC_USE_MOCK=dashboard           only the dashboard is mocked; sign-in, roles and clients use the API  <- now
#   NEXT_PUBLIC_USE_MOCK=dashboard,clients   several areas, comma separated
#   NEXT_PUBLIC_USE_MOCK=true                everything is mocked; no Laravel needed (also: all)
#   NEXT_PUBLIC_USE_MOCK=false               nothing is mocked (also: leave it empty)
#
# Areas: auth (sign-in, /me, sign-out), dashboard, roles (roles + permission catalog), clients, staff.
# Mocked areas with a real sign-in skip the permission check (the real session decides who is signed in).
NEXT_PUBLIC_USE_MOCK=dashboard

# Where "Go to the client area" on the login page points.
# NEXT_PUBLIC_CLIENT_AREA_URL=http://localhost:3002
